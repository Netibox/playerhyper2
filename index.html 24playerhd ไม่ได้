<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HLS Player</title>
<style>
* { box-sizing: border-box; }
html, body {
    margin: 0; padding: 0;
    width: 100%; height: 100%;
    background: #111; color: #fff;
    font-family: Arial, sans-serif;
}
body {
    display: flex;
    justify-content: center;
    align-items: center;
}
.container {
    width: 100%;
    max-width: 900px;
    padding: 15px;
}
.player {
    position: relative;
    width: 100%;
    background: #000;
    aspect-ratio: 16 / 9;
}
video {
    width: 100%; height: 100%;
    display: block;
    background: #000;
}
.controls-box {
    display: flex;
    gap: 8px;
    margin-top: 15px;
}
input {
    flex: 1;
    min-width: 0;
    padding: 13px;
    background: #222; color: white;
    border: 1px solid #444;
    border-radius: 6px;
    font-size: 14px;
}
button {
    padding: 12px 20px;
    border: 0; border-radius: 6px;
    background: #1677ff; color: white;
    font-size: 16px;
    cursor: pointer;
}
button:hover { background: #338aff; }
button:active { transform: scale(.97); }
button:disabled {
    background: #444;
    cursor: not-allowed;
}
#status {
    margin-top: 12px;
    padding: 11px;
    background: #222;
    border-radius: 6px;
    color: #ccc;
    font-size: 13px;
    font-family: monospace;
    line-height: 1.6;
    max-height: 220px;
    overflow-y: auto;
}
.title {
    margin-bottom: 10px;
    font-size: 20px;
    font-weight: bold;
}
</style>
</head>

<body>
<div class="container">
    <div class="title">HLS Player</div>

    <div class="player">
        <video id="video" controls playsinline preload="auto"></video>
    </div>

    <div class="controls-box">
        <input id="url" value="https://main.24playerhd.com/newplaylist/8da92998e83b1d45b018bd3d/8da92998e83b1d45b018bd3d.m3u8" placeholder="ใส่ URL .m3u8">
        <button id="load">▶ โหลด</button>
    </div>

    <div id="status">กำลังเตรียม...</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/hls.js@1.6.16"></script>
<script>
const video = document.getElementById("video");
const urlInput = document.getElementById("url");
const loadButton = document.getElementById("load");
const statusBox = document.getElementById("status");

let hls = null;
let isLoading = false;
let loadTimer = null;
let fallbackTimer = null;

// ตรวจจับ Browser จริง ๆ
const ua = navigator.userAgent;
const isSafari = /^((?!chrome|android).)*safari/i.test(ua);
const isIOS = /iPad|iPhone|iPod/.test(ua);
const isEdge = /Edg/.test(ua);
const isChrome = /Chrome/.test(ua) && !isEdge;

function log(text) {
    const time = new Date().toLocaleTimeString("th-TH");
    const line = `[${time}] ${text}`;
    console.log(line);
    const arr = statusBox.innerHTML.split('<br>').filter(x => x.trim());
    arr.push(line.replace(/</g, '&lt;'));
    if (arr.length > 25) arr.shift();
    statusBox.innerHTML = arr.join('<br>');
}

function clearTimers() {
    if (loadTimer) { clearTimeout(loadTimer); loadTimer = null; }
    if (fallbackTimer) { clearTimeout(fallbackTimer); fallbackTimer = null; }
}

function destroyHLS() {
    if (hls) {
        try { hls.destroy(); } catch (e) {}
        hls = null;
    }
}

function resetPlayer() {
    clearTimers();
    destroyHLS();
    video.pause();
    video.removeAttribute("src");
    video.load();
}

function loadStream(url) {
    if (!url) {
        log("❌ กรุณาใส่ URL");
        return;
    }
    if (isLoading) {
        log("⏳ รอโหลดปัจจุบันให้เสร็จก่อน...");
        return;
    }

    isLoading = true;
    loadButton.disabled = true;
    resetPlayer();
    log("⏳ เริ่มโหลด...");

    // รอ HLS.js โหลด
    if (typeof Hls === "undefined") {
        log("⏳ รอ HLS.js...");
        loadTimer = setTimeout(() => {
            isLoading = false;
            loadButton.disabled = false;
            loadStream(url);
        }, 1500);
        return;
    }

    // ========== ใช้ Native HLS เฉพาะ Safari / iOS จริง ๆ เท่านั้น ==========
    // Edge/Chrome ที่มี Extension อาจรายงานว่ารองรับ แต่เล่นไม่ได้
    const canNative = video.canPlayType("application/vnd.apple.mpegurl") !== "";
    
    if (canNative && (isSafari || isIOS)) {
        log("🍎 Native HLS (Safari)");
        video.src = url;
        
        let worked = false;
        const onMeta = () => {
            worked = true;
            log("▶ Native พร้อมเล่น");
            video.play().catch(() => log("▶ กด Play เอง"));
            cleanup();
            finish();
        };
        const onErr = () => {
            if (worked) return;
            log("❌ Native ล้มเหลว → ลอง HLS.js");
            cleanup();
            video.removeAttribute("src");
            video.load();
            loadWithHLSjs(url);
        };
        const cleanup = () => {
            video.removeEventListener("loadedmetadata", onMeta);
            video.removeEventListener("error", onErr);
            clearTimers();
        };
        
        video.addEventListener("loadedmetadata", onMeta);
        video.addEventListener("error", onErr);
        
        // ถ้า 6 วิไม่ตอบสนอง ให้ fallback
        fallbackTimer = setTimeout(() => {
            if (!worked) {
                log("⚠️ Native ไม่ตอบสนอง → ใช้ HLS.js");
                cleanup();
                video.removeAttribute("src");
                video.load();
                loadWithHLSjs(url);
            }
        }, 6000);
        return;
    }

    // ถ้าเป็น Edge/Chrome แต่รายงานว่ารองรับ Native ให้ข้ามไป HLS.js เลย
    if (canNative && !isSafari && !isIOS) {
        log("⚠️ ไม่ใช่ Safari แต่รายงาน Native → ใช้ HLS.js แทน");
    }

    loadWithHLSjs(url);
}

function loadWithHLSjs(url) {
    if (!Hls.isSupported()) {
        log("❌ Browser ไม่รองรับ HLS.js");
        finish();
        return;
    }

    log("🔧 HLS.js v" + Hls.version);

    hls = new Hls({
        enableWorker: true,
        lowLatencyMode: false,
        backBufferLength: 30,
        maxBufferLength: 30,
        maxMaxBufferLength: 60,
        manifestLoadingMaxRetry: 2,
        manifestLoadingRetryDelay: 3000,
        levelLoadingMaxRetry: 2,
        levelLoadingRetryDelay: 3000,
        fragLoadingMaxRetry: 3,
        fragLoadingRetryDelay: 3000,
        xhrSetup: function(xhr) { xhr.withCredentials = false; }
    });

    hls.attachMedia(video);

    hls.on(Hls.Events.MEDIA_ATTACHED, () => {
        log("⏳ โหลด Playlist...");
        hls.loadSource(url);
    });

    hls.on(Hls.Events.MANIFEST_PARSED, (evt, data) => {
        const lv = data.levels || [];
        log(`✅ Playlist OK (${lv.length} คุณภาพ)`);
        video.play().catch(() => log("▶ กด Play เอง"));
        finish();
    });

    hls.on(Hls.Events.LEVEL_LOADED, (evt, data) => {
        log(`📦 โหลดแล้ว ${Math.round(data.details.totalduration)} วินาที`);
    });

    hls.on(Hls.Events.ERROR, (evt, data) => {
        console.error(data);
        if (!data.fatal) return;
        
        switch (data.type) {
            case Hls.ErrorTypes.NETWORK_ERROR:
                let m = "❌ Network";
                if (!data.response) {
                    m = "❌ เชื่อมต่อไม่ได้ (Offline หรือถูกบล็อก)";
                } else if (data.response.code === 0) {
                    m = "❌ CORS ถูกบล็อก หรือไม่มีการตอบสนอง";
                } else if (data.response.code === 404) {
                    m = "❌ 404 ไม่พบไฟล์ (ลิงก์หมดอายุ?)";
                } else if (data.response.code >= 500) {
                    m = `❌ Server Error ${data.response.code}`;
                } else {
                    m = `❌ HTTP ${data.response.code}`;
                }
                log(m);
                
                if (data.response && data.response.code === 0) {
                    log("💡 แนะนำ: ติดตั้ง Extension 'CORS Unblock'");
                }
                
                if (!hls._retried) {
                    hls._retried = true;
                    log("🔄 Retry อัตโนมัติ...");
                    setTimeout(() => hls.startLoad(), 3000);
                } else {
                    finish();
                }
                break;
                
            case Hls.ErrorTypes.MEDIA_ERROR:
                log("❌ Media Error → กู้คืน...");
                hls.recoverMediaError();
                break;
                
            default:
                log("❌ Fatal: " + data.details);
                finish();
                destroyHLS();
        }
    });

    video.addEventListener("playing", () => log("▶ เล่นอยู่"));
    video.addEventListener("waiting", () => log("⏳ บัฟเฟอร์..."));
    video.addEventListener("canplay", () => log("✅ พร้อมเล่น"));
    video.addEventListener("stalled", () => log("⏳ เน็ตช้า..."));
    video.addEventListener("error", () => {
        const e = video.error;
        if (e) log(`❌ Video Error ${e.code}: ${e.message}`);
        finish();
    });
}

function finish() {
    isLoading = false;
    loadButton.disabled = false;
}

loadButton.addEventListener("click", () => loadStream(urlInput.value.trim()));
urlInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") loadStream(urlInput.value.trim());
});

window.addEventListener("load", () => {
    log("🚀 Browser: " + ua.substring(0, 40));
    setTimeout(() => loadStream(urlInput.value.trim()), 600);
});
</script>
</body>
</html>
